{
  "name": "openastra",
  "version": "0.1.0",
  "private": true,
  "description": "玩别人做好的 Astra 游戏，也能用一句话做一局自己的。",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
